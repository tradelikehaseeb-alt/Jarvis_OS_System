{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "module": "CommonJS",
    "moduleResolution": "node",
    "outDir": "dist",
    "rootDir": "src",
    "noEmit": false,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "types": ["node"],
    "paths": {
      "@jarvis/desktop-intent": ["./src/renderer/intent/index.ts"],
      "@jarvis/desktop-intent/*": ["./src/renderer/intent/*"]
    }
  },
  "include": [
    "src/main.ts",
    "src/desktop-env-bootstrap.ts",
    "src/preload.ts",
    "src/load-env.ts",
    "src/ensure-electron-memory-backend.ts",
    "src/ipc/**/*.ts"
  ],
  "exclude": ["node_modules", "dist", "src/renderer"]
}
