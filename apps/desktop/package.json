{
  "name": "@jarvis/desktop",
  "version": "0.0.0",
  "private": true,
  "description": "Jarvis OS desktop shell (Electron) — Phase 18",
  "main": "dist/main.js",
  "scripts": {
    "build:renderer": "vite build",
    "build:main": "tsc -p tsconfig.main.json",
    "build": "npm run build:renderer && npm run build:main",
    "dev": "npm run build && electron -r tsx/cjs .",
    "rebuild:native": "electron-rebuild -f -w better-sqlite3",
    "postinstall": "electron-rebuild -f -w better-sqlite3 || node -e \"console.warn('[jarvis/desktop] better-sqlite3 electron-rebuild skipped (install Visual Studio Build Tools to enable SQLite in Electron)')\"",
    "lint": "tsc -p tsconfig.main.json --noEmit && tsc -p tsconfig.renderer.json --noEmit",
    "test": "vitest run"
  },
  "dependencies": {
    "@jarvis/api-runtime": "*",
    "@jarvis/hermes": "*",
    "@jarvis/local-memory": "*",
    "@jarvis/orchestrator": "*",
    "@jarvis/provider-runtime": "*",
    "buffer": "^6.0.3",
    "dotenv": "^17.4.2",
    "@jarvis/runtime-process": "*",
    "@jarvis/speech-service": "*",
    "@jarvis/types": "*",
    "electron": "^42.3.2",
    "framer-motion": "^12.40.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^3.7.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^22.15.21",
    "@types/react": "^19.1.4",
    "@types/react-dom": "^19.1.5",
    "@vitejs/plugin-react": "^4.4.1",
    "jsdom": "^26.1.0",
    "tsx": "^4.22.3",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vitest": "^4.1.8"
  }
}
