{
  "extends": "../../tsconfig.json",
  "compilerOptions": {
    "outDir": "dist",
    "rootDir": "src",
    "noEmit": false,
    "declaration": true,
    "declarationMap": true,
    "paths": {
      "@jarvis/desktop-intent": ["../../apps/desktop/src/renderer/intent/index.ts"],
      "@jarvis/desktop-intent/*": ["../../apps/desktop/src/renderer/intent/*"],
      "@jarvis/local-memory": ["../local-memory/src/index.ts"],
      "@jarvis/local-memory/*": ["../local-memory/src/*"]
    }
  },
  "include": ["src/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
