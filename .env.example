# =============================================================================
# Jarvis OS — environment template (copy to .env and fill values)
# Phase 1: configuration only — no secrets in repo
# =============================================================================

# --- General ---
NODE_ENV=development
JARVIS_ENV=development

# --- Web (Next.js) — apps/web ---
NEXT_PUBLIC_APP_NAME=Jarvis OS
NEXT_PUBLIC_API_URL=http://localhost:8787

# --- Desktop (Electron) — apps/desktop ---
ELECTRON_RENDERER_URL=http://localhost:3000

# --- API Gateway — services/api-gateway ---
API_HOST=0.0.0.0
API_PORT=8787
API_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# stub | http | local_bridge
JARVIS_ORCHESTRATOR_CLIENT=http
JARVIS_ORCHESTRATOR_URL=http://localhost:8787
JARVIS_INTERNAL_TOKEN=your-internal-token

# --- Database ---
DATABASE_URL=postgresql://jarvis:jarvis@localhost:5432/jarvis
DATABASE_POOL_SIZE=10

# --- Memory service ---
MEMORY_SERVICE_URL=http://localhost:8001

# --- Orchestrator ---
ORCHESTRATOR_URL=http://localhost:8002
# Hermes: stub | planning | local (Python run_agent.py) | official (HTTP plan API) | cloud
HERMES_MODE=local
HERMES_AGENT_PATH=
HERMES_PATH=
HERMES_USE_PYTHON_AGENT=true
HERMES_PYTHON=py -3.11
HERMES_ENDPOINT=http://127.0.0.1:8080
HERMES_PLANNING_ADAPTER=planning
# Skip duplicate orchestrator LLM planning when Hermes official/local is active
JARVIS_ALLOW_ORCHESTRATOR_LLM_PLANNING=false
# Real composed workflow (Hermes → OpenClaw steps). Set false only in vitest/CI.
ORCHESTRATOR_EXECUTE_COMPOSED_WORKFLOW=true
JARVIS_USER_DISPLAY_NAME=Haseeb Rasheed
# Memory: memory-service (SQLite, Node only) | local (in-memory Maps — required for Electron)
JARVIS_MEMORY_BACKEND=local
JARVIS_MEMORY_PATH=
MEMORY_USE_IN_MEMORY_STORAGE=true
MEMORY_FORCE_STUB_COMPONENTS=false

# --- LLM providers ---
# Set JARVIS_LLM_PROVIDER to your preferred provider
# JARVIS_ALLOW_LLM_STUB_FALLBACK=false means error if no key found (recommended)
JARVIS_LLM_PROVIDER=groq
JARVIS_ALLOW_LLM_STUB_FALLBACK=false
# Never commit real keys here - copy to .env only
GROQ_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
MINIMAX_API_KEY=
# Ollama: local http://localhost:11434 — no key needed

# --- Browser / Playwright ---
# Set JARVIS_BROWSER_REAL=true to enable real Playwright browser
# Set JARVIS_BROWSER_HEADLESS=false to see browser window
JARVIS_BROWSER_REAL=true
JARVIS_BROWSER_HEADLESS=false

# --- OpenClaw ---
# stub = CI | local = Jarvis Playwright | official = OpenClaw gateway tools
OPENCLAW_MODE=official
OPENCLAW_GATEWAY_URL=http://127.0.0.1:18789
OPENCLAW_ENDPOINT=http://127.0.0.1:18789
OPENCLAW_GATEWAY_TOKEN=your-gateway-token
JARVIS_BROWSER_REAL=false
OPENCLAW_SANDBOX_ENABLED=true

# --- Search (Phase 2) ---
# Get free key at serper.dev (2500 free searches)
SERPER_API_KEY=

# --- Workspace (file-skill) ---
JARVIS_WORKSPACE_PATH=

# --- Speech STT/TTS ---
JARVIS_STT_PROVIDER=groq
JARVIS_STT_FALLBACK=local
JARVIS_TTS_PROVIDER=edge-tts
JARVIS_TTS_VOICE=en-US-GuyNeural
JARVIS_TTS_SPEED=+0%
JARVIS_TTS_VOLUME=+0%
# STT priority: Jarvis (Groq Whisper → faster-whisper local) → OpenAI → Deepgram
# TTS priority: Jarvis (Edge TTS → pyttsx3) → OpenAI TTS → ElevenLabs
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=

# --- Auth ---
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# --- Docker / infrastructure ---
COMPOSE_PROJECT_NAME=jarvis-os
POSTGRES_USER=jarvis
POSTGRES_PASSWORD=jarvis
POSTGRES_DB=jarvis