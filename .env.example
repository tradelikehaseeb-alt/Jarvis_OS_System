# =============================================================================
# Jarvis OS — environment template (copy to .env and fill values)
# Phase 1: configuration only — no secrets in repo
# =============================================================================

# --- General ---
NODE_ENV=development
JARVIS_ENV=development

# --- Web (Next.js) — apps/web ---
NEXT_PUBLIC_APP_NAME=Jarvis OS
NEXT_PUBLIC_API_URL=http://localhost:8787

# --- Desktop (Electron) — apps/desktop ---
ELECTRON_RENDERER_URL=http://localhost:3000

# --- API Gateway — services/api-gateway ---
API_HOST=0.0.0.0
API_PORT=8787
API_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
JARVIS_ORCHESTRATOR_CLIENT=local_bridge

# --- Database ---
DATABASE_URL=postgresql://jarvis:jarvis@localhost:5432/jarvis
DATABASE_POOL_SIZE=10

# --- Memory service ---
MEMORY_SERVICE_URL=http://localhost:8001

# --- Orchestrator ---
ORCHESTRATOR_URL=http://localhost:8002
# Hermes: stub | local | official | cloud (official = Nous Hermes HTTP plan API)
HERMES_MODE=stub
HERMES_ENDPOINT=http://127.0.0.1:8080
HERMES_PLANNING_ADAPTER=planning
# Skip duplicate orchestrator LLM planning when Hermes official/local is active
JARVIS_ALLOW_ORCHESTRATOR_LLM_PLANNING=false
# Memory: memory-service (default) | local (dev fallback)
JARVIS_MEMORY_BACKEND=memory-service

# --- LLM providers ---
# Set JARVIS_LLM_PROVIDER to your preferred provider
# JARVIS_ALLOW_LLM_STUB_FALLBACK=false means error if no key found (recommended)
JARVIS_LLM_PROVIDER=groq
JARVIS_ALLOW_LLM_STUB_FALLBACK=false
# Never commit real keys here - copy to .env only
GROQ_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
MINIMAX_API_KEY=
# Ollama: local http://localhost:11434 — no key needed

# --- Browser / Playwright ---
# Set JARVIS_BROWSER_REAL=true to enable real Playwright browser
# Set JARVIS_BROWSER_HEADLESS=false to see browser window
JARVIS_BROWSER_REAL=true
JARVIS_BROWSER_HEADLESS=false

# --- OpenClaw ---
# stub = CI | local = Jarvis Playwright | official = OpenClaw gateway tools
OPENCLAW_MODE=stub
OPENCLAW_ENDPOINT=http://127.0.0.1:18789
OPENCLAW_GATEWAY_TOKEN=
OPENCLAW_SANDBOX_ENABLED=true

# --- Search (Phase 2) ---
# Get free key at serper.dev (2500 free searches)
SERPER_API_KEY=

# --- Speech STT/TTS ---
# STT priority: Groq Whisper (uses GROQ_API_KEY) → OpenAI Whisper → Deepgram
# TTS priority: Edge TTS (no key) → OpenAI TTS → ElevenLabs
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=

# --- Auth ---
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# --- Docker / infrastructure ---
COMPOSE_PROJECT_NAME=jarvis-os
POSTGRES_USER=jarvis
POSTGRES_PASSWORD=jarvis
POSTGRES_DB=jarvis