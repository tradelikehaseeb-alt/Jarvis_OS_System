# =============================================================================
# Jarvis OS — environment template (copy to .env and fill values)
# Phase 1: configuration only — no secrets in repo
# =============================================================================

# --- General ---
NODE_ENV=development
JARVIS_ENV=development

# --- Web (Next.js) — apps/web ---
NEXT_PUBLIC_APP_NAME=Jarvis OS
NEXT_PUBLIC_API_URL=http://localhost:8000

# --- Desktop (Electron) — apps/desktop ---
ELECTRON_RENDERER_URL=http://localhost:3000

# --- API Gateway (FastAPI) — services/api-gateway ---
API_HOST=0.0.0.0
API_PORT=8000
API_CORS_ORIGINS=http://localhost:3000,http://localhost:5173
# stub = tests/CI | local_bridge = LocalCliTransport (temp dev) | node = alias for local_bridge
JARVIS_ORCHESTRATOR_CLIENT=local_bridge

# --- Database — database/ ---
DATABASE_URL=postgresql://jarvis:jarvis@localhost:5432/jarvis
DATABASE_POOL_SIZE=10

# --- Memory service — services/memory-service ---
MEMORY_SERVICE_URL=http://localhost:8001

# --- Orchestrator — services/orchestrator ---
ORCHESTRATOR_URL=http://localhost:8002
HERMES_PLANNING_ADAPTER=planning

# --- LLM providers (set any one for live inference) ---
OPENAI_API_KEY=
GROQ_API_KEY=
GEMINI_API_KEY=
GOOGLE_API_KEY=
OPENROUTER_API_KEY=
DEEPSEEK_API_KEY=
MINIMAX_API_KEY=
# Ollama: local http://localhost:11434 — no key

# --- Speech STT/TTS (Phase 91+) ---
DEEPGRAM_API_KEY=
ELEVENLABS_API_KEY=
# OPENAI_API_KEY and GROQ_API_KEY also used for Whisper / Groq STT

# --- Auth (future) ---
JWT_SECRET=change-me-in-production
JWT_EXPIRES_IN=7d

# --- OpenClaw gateway (future — never expose to frontend) ---
OPENCLAW_GATEWAY_URL=http://localhost:8010
OPENCLAW_SANDBOX_ENABLED=true

# --- Docker / infrastructure ---
COMPOSE_PROJECT_NAME=jarvis-os
POSTGRES_USER=jarvis
POSTGRES_PASSWORD=jarvis
POSTGRES_DB=jarvis
